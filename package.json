{
  "name": "kithlink",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @kithlink/db generate",
    "db:migrate": "pnpm --filter @kithlink/db migrate"
  },
  "devDependencies": {
    "eslint": "^9.30.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.3.5"
    }
  }
}
