{
  "name": "@kithlink/server",
  "version": "0.1.0",
  "private": true,
 "scripts": {
  "dev": "tsx watch src/main.api.ts",
  "dev:worker": "tsx watch src/main.worker-verify.ts",
  "build": "tsc -p tsconfig.json",
  "start": "node dist/main.api.js",
  "start:worker": "node dist/main.worker-verify.js",
  "test": "vitest run",
  "typecheck": "tsc -p tsconfig.json --noEmit",
  "lint": "eslint src",
  "seed": "tsx scripts/seed.ts"
 },
 "dependencies": {
  "@aws-sdk/client-s3": "^3.750.0",
  "@aws-sdk/s3-request-presigner": "^3.750.0",
   "@kithlink/contracts": "workspace:*",
   "@kithlink/db": "workspace:*",
   "@kithlink/sync-adapters": "workspace:*",
   "@nestjs/common": "^11",
  "@nestjs/config": "^4",
  "@nestjs/core": "^11",
  "@nestjs/platform-express": "^11",
  "@node-rs/argon2": "^2",
  "bullmq": "^5.34.0",
  "cookie-parser": "^1.4.7",
  "drizzle-orm": "^0.44.7",
  "helmet": "^8",
  "ioredis": "^5.6.1",
  "nodemailer": "^6.10.1",
  "reflect-metadata": "^0.2.2",
  "rxjs": "^7.8.2",
  "zod": "^3.25.67"
 },
 "devDependencies": {
  "@nestjs/testing": "^11.2.1",
  "@types/cookie-parser": "^1.4.9",
  "@types/express": "^5.0.1",
  "@types/node": "^22.15.0",
  "@types/nodemailer": "^6.4.17",
  "@types/supertest": "^6.0.3",
  "supertest": "^7.1.1",
  "tsx": "^4.20.3",
  "typescript": "^5.8.3",
  "vitest": "^3.2.4"
 }
}
