# Kithlink local dev environment (copy to .env — DEV-ONLY credentials)
DATABASE_URL=postgres://kithlink_app:kithlink_app_dev@localhost:5432/kithlink
DATABASE_OWNER_URL=postgres://kithlink:kithlink_dev@localhost:5432/kithlink

REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=kithlink-local
S3_ACCESS_KEY_ID=kithlink
S3_SECRET_ACCESS_KEY=kithlink_dev_minio

# 32-byte base64 master key for envelope encryption (address_enc, artifact files).
# Leave unset in dev to derive from DATABASE_URL hash (server warns; NEVER in prod).
KITHLINK_MASTER_KEY=

# Optional OpenAI-compatible extraction endpoint for worker-verify (unset = no LLM stage).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

SMTP_URL=smtp://localhost:1025
MAIL_FROM="Kithlink <no-reply@localhost>"

APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_PORT=4000
