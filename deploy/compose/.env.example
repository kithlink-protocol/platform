# Kithlink local dev environment (copy to .env — DEV-ONLY credentials)
DATABASE_URL=postgres://kithlink_app:kithlink_app_dev@localhost:5432/kithlink
DATABASE_OWNER_URL=postgres://kithlink:kithlink_dev@localhost:5432/kithlink

REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=kithlink-local
S3_ACCESS_KEY_ID=kithlink
S3_SECRET_ACCESS_KEY=kithlink_dev_minio

# 32-byte base64 master key for envelope encryption (address_enc, artifact files).
# Leave unset in dev to derive from DATABASE_URL hash (server warns; NEVER in prod).
KITHLINK_MASTER_KEY=

# Optional OpenAI-compatible extraction endpoint for worker-verify (unset = no LLM stage).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

SMTP_URL=smtp://localhost:1025
MAIL_FROM="Kithlink <no-reply@localhost>"

APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_PORT=4000
# Same-origin /api rewrite target for web + admin Next dev servers.
API_URL=http://localhost:4000

# Hosts that belong to the app itself (comma-separated host[:port]). Any other
# Host header is treated as a shelter site and resolved via /public/v1/sites/resolve
# (e.g. happytail.sites.localhost -> site for slug "happytail").
# Production: wildcard DNS *.SITES_ROOT_DOMAIN -> web host, plus a TLS cert
# covering that wildcard (e.g. *.sites.example.org).
APP_PRIMARY_HOSTS=localhost:3000,127.0.0.1:3000

# M3: nightly listing-sync cron in main.api (1 = enabled). Runs live targets every 24h.
ENABLE_SYNC_CRON=
# Force the Petfinder adapter into sandbox mode regardless of per-target mode.
PETFINDER_MODE=dry_run
# Override only for tests/proxies; defaults to https://api.petfinder.com/v2.
PETFINDER_API_BASE=

# Force the Adopt-a-Pet adapter into sandbox mode regardless of per-target mode.
ADOPTAPET_MODE=dry_run
# Override only for tests/proxies; defaults to https://api.adoptapet.com.
ADOPTPET_API_BASE=

# Set to 1 to disable in-memory rate limiting (dev/tests only — never in prod).
RATE_LIMIT_OFF=

# Root domain serving shelter sites as <slug>.SITES_ROOT_DOMAIN (default sites.localhost).
SITES_ROOT_DOMAIN=sites.localhost
# Client-side mirror for admin/site page links; must match SITES_ROOT_DOMAIN.
NEXT_PUBLIC_SITES_ROOT_DOMAIN=sites.localhost
