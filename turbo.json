{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "TEST_DATABASE_URL",
    "DATABASE_URL",
    "DATABASE_OWNER_URL",
    "NODE_ENV",
    "API_PORT",
    "APP_URL",
    "ADMIN_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
